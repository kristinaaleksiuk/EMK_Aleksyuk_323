<Page x:Class="_323_Aleksyuk_EMK.Pages.AddPatientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_323_Aleksyuk_EMK.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
          Title="ЭМК — Пациент">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320" Margin="0,16">
            <TextBlock x:Name="TbTitle" Text="Новый пациент" Style="{StaticResource TitleText}" />

            <StackPanel Width="260">
                <TextBlock Text="ФИО" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="TbFio" ToolTip="Введите ФИО пациента" />

                <TextBlock Text="Дата рождения" Style="{StaticResource FieldLabel}" />
                <DatePicker x:Name="DpBirth" ToolTip="Выберите дату рождения" />

                <TextBlock Text="Телефон" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="TbPhone" ToolTip="Введите телефон" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Сохранить" ToolTip="Сохранить данные" Click="BtnSave_Click" />
                <Button Content="Отмена" ToolTip="Вернуться к списку" Style="{StaticResource SecondaryButton}" Click="BtnCancel_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
