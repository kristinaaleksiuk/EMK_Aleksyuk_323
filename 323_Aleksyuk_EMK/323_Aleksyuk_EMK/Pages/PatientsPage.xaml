<Page x:Class="_323_Aleksyuk_EMK.Pages.PatientsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_323_Aleksyuk_EMK.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
          Title="ЭМК — Пациенты" Loaded="Page_Loaded">
    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Пациенты" Style="{StaticResource SectionTitle}" FontSize="22" Margin="0,0,0,6" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <StackPanel Margin="0,0,14,0">
                <TextBlock Text="Поиск по ФИО или телефону" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                <TextBox x:Name="TbSearch" ToolTip="Введите часть ФИО или телефона" TextChanged="Filter_Changed" />
            </StackPanel>
            <Button Content="Сбросить" VerticalAlignment="Bottom" Style="{StaticResource SecondaryButton}"
                    ToolTip="Очистить фильтр" Click="BtnReset_Click" />
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="DgPatients">
            <DataGrid.Columns>
                <DataGridTextColumn Header="id" Binding="{Binding id}" Width="60" />
                <DataGridTextColumn Header="ФИО" Binding="{Binding FIO}" Width="2*" />
                <DataGridTextColumn Header="Дата рождения" Binding="{Binding BirthText}" Width="*" />
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Добавить" ToolTip="Добавить пациента" Click="BtnAdd_Click" />
            <Button Content="Изменить" ToolTip="Изменить выбранного пациента" Click="BtnEdit_Click" />
            <Button Content="Удалить" ToolTip="Удалить выбранного пациента" Style="{StaticResource DangerButton}" Click="BtnDelete_Click" />
        </StackPanel>
    </Grid>
</Page>