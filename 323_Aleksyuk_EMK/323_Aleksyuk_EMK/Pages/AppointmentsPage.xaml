<Page x:Class="_323_Aleksyuk_EMK.Pages.AppointmentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_323_Aleksyuk_EMK.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ЭМК — Приёмы" Loaded="Page_Loaded">
    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Записи на приём" Style="{StaticResource SectionTitle}" FontSize="22" Margin="0,0,0,6" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <StackPanel Margin="0,0,14,0">
                <TextBlock Text="Поиск по пациенту или врачу" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                <TextBox x:Name="TbSearch" ToolTip="Введите часть ФИО пациента или врача" TextChanged="Filter_Changed" />
            </StackPanel>
            <StackPanel Margin="0,0,14,0">
                <TextBlock Text="Статус" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                <ComboBox x:Name="CbStatus" SelectedIndex="0" Width="160" ToolTip="Фильтр по статусу"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Все" />
                    <ComboBoxItem Content="Запланирован" />
                    <ComboBoxItem Content="Завершён" />
                    <ComboBoxItem Content="Отменён" />
                </ComboBox>
            </StackPanel>
            <Button Content="Сбросить" VerticalAlignment="Bottom" Style="{StaticResource SecondaryButton}"
                    ToolTip="Очистить фильтры" Click="BtnReset_Click" />
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="DgAppointments">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding schedule.visit_date, StringFormat=dd.MM.yyyy}" Width="*" />
                <DataGridTextColumn Header="Время" Binding="{Binding schedule.time_start, StringFormat=hh\\:mm}" Width="0.7*" />
                <DataGridTextColumn Header="Пациент" Binding="{Binding patient.fio}" Width="2*" />
                <DataGridTextColumn Header="Врач" Binding="{Binding schedule.doctor.fio}" Width="2*" />
                <DataGridTextColumn Header="Профиль" Binding="{Binding schedule.doctor.specialization.name}" Width="1.3*" />
                <DataGridTextColumn Header="Статус" Binding="{Binding status}" Width="1.2*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Добавить" ToolTip="Записать пациента на приём" Click="BtnAdd_Click" />
            <Button Content="Изменить" ToolTip="Изменить выбранную запись" Click="BtnEdit_Click" />
            <Button Content="Отменить запись" ToolTip="Отменить выбранную запись" Style="{StaticResource DangerButton}" Click="BtnCancel_Click" />
            <Button Content="Талон" ToolTip="Талон на выбранный приём для печати" Click="BtnTicket_Click" />
        </StackPanel>
    </Grid>
</Page>
