<Page x:Class="_323_Aleksyuk_EMK.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_323_Aleksyuk_EMK.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
          Title="ЭМК — Страница пользователя" Loaded="Page_Loaded">
    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Grid Width="96" Height="96">
                <Ellipse Fill="{DynamicResource SecondaryBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" />
                <Ellipse x:Name="PhotoEllipse" Margin="2" />
                <TextBlock x:Name="PhotoHint" Text="Фото" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#7A7F8C" FontSize="12" />
            </Grid>
            <StackPanel VerticalAlignment="Center" Margin="22,0,0,0">
                <TextBlock x:Name="TbName" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" />
                <TextBlock x:Name="TbInfo" FontSize="14" Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,14,0,8">
            <TextBlock Text="Мои приёмы" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Поиск по врачу, кабинету или дате" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                    <TextBox x:Name="TbSearch" ToolTip="Введите часть ФИО врача, номер кабинета или дату (дд.мм.гггг)"
                             TextChanged="Filter_Changed" />
                </StackPanel>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Статус" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                    <ComboBox x:Name="CbStatus" SelectedIndex="0" Width="160" ToolTip="Фильтр по статусу"
                              SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="Все" />
                        <ComboBoxItem Content="Запланирован" />
                        <ComboBoxItem Content="Завершён" />
                        <ComboBoxItem Content="Отменён" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Сортировка" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                    <ComboBox x:Name="CbSort" SelectedIndex="0" Width="200" ToolTip="Порядок отображения приёмов"
                              SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="Дата: сначала новые" />
                        <ComboBoxItem Content="Дата: сначала старые" />
                        <ComboBoxItem Content="Врач: А–Я" />
                        <ComboBoxItem Content="Врач: Я–А" />
                        <ComboBoxItem Content="Статус" />
                    </ComboBox>
                </StackPanel>
                <Button Content="Сбросить" VerticalAlignment="Bottom" Style="{StaticResource SecondaryButton}"
                        ToolTip="Очистить поиск, фильтр и сортировку" Click="BtnReset_Click" />
            </StackPanel>
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="DgAppointments">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding schedule.visit_date}" Width="1.3*" />
                <DataGridTextColumn Header="Врач" Binding="{Binding schedule.doctor.fio}" Width="1.3*" />
                <DataGridTextColumn Header="Кабинет" Binding="{Binding schedule.doctor.cabinet}" Width="*" />
                <DataGridTextColumn Header="Статус" Binding="{Binding status}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Записаться на приём" Width="160" ToolTip="Записаться на приём к врачу" Click="BtnAddPreem_Click" />
            <Button Content="Сменить пароль" ToolTip="Сменить пароль" Style="{StaticResource SecondaryButton}" Click="BtnChangePass_Click" />
            <Button Content="Выйти" ToolTip="Выйти из системы" Style="{StaticResource SecondaryButton}" Click="BtnLogout_Click" />
        </StackPanel>
    </Grid>
</Page>