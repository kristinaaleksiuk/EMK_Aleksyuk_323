<Page x:Class="_323_Aleksyuk_EMK.Pages.ChartsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_323_Aleksyuk_EMK.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
         Title="ЭМК — Диаграммы и экспорт">
    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Приёмы по врачам" Style="{StaticResource SectionTitle}" FontSize="22" Margin="0,0,0,6" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Диаграмма Chart в WindowsFormsHost --><!--
            <wfi:WindowsFormsHost Grid.Column="0" Margin="0,0,16,0">
                <charts:Chart x:Name="ChartMain" BackColor="White" />
            </wfi:WindowsFormsHost>-->

            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Врач" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="CmbDoctor" DisplayMemberPath="FIO" ToolTip="Выберите врача"
                          SelectionChanged="UpdateChart" />

                <TextBlock Text="Тип диаграммы" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="CmbType" DisplayMemberPath="Key" SelectedValuePath="Value"
                          ToolTip="Выберите тип диаграммы" SelectionChanged="UpdateChart" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Экспорт" Style="{StaticResource SectionTitle}" Margin="0,8,0,4" />
            <StackPanel Orientation="Horizontal">
                <Button Content="В Word" ToolTip="Выгрузить отчёт в Microsoft Word" Click="BtnWord_Click" />
                <Button Content="В Excel" ToolTip="Выгрузить таблицу в Microsoft Excel" Click="BtnExcel_Click" />
                <Button Content="В PDF" ToolTip="Сохранить отчёт в формате PDF" Click="BtnPdf_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>