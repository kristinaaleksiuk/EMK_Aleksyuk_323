<Page x:Class="_323_Aleksyuk_EMK.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_323_Aleksyuk_EMK.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
        Title="ЭМК — Авторизация">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="330" Margin="0,16">
            <TextBlock Text="Вход в систему" Style="{StaticResource TitleText}" />

            <StackPanel Width="260">
                <TextBlock Text="Логин" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="TbLogin"  ToolTip="Введите логин" />
                <Label x:Name="lblLoginHint" Content="Введите логин" Style="{StaticResource HintLabel}"
           MouseLeftButtonUp="lblLoginHint_MouseLeftButtonUp" />

                <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="PbPassword" ToolTip="Введите пароль" />
                <Label x:Name="lblPassHint" Content="Введите пароль" Style="{StaticResource HintLabel}"
           MouseLeftButtonUp="lblPassHint_MouseLeftButtonUp" />

                <StackPanel x:Name="CaptchaPanel" Visibility="Collapsed">
                    <TextBlock Text="Капча" Style="{StaticResource FieldLabel}" />
                    <Border Background="{DynamicResource SecondaryBrush}"
                            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Height="54">
                        <TextBlock x:Name="CaptchaText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="26" FontStyle="Italic" FontWeight="Bold"
                                   Foreground="{DynamicResource CaptchaTextBrush}"
                                   TextDecorations="Strikethrough"
                                   ToolTip="Капча нельзя скопировать - вводите вручную" />
                    </Border>
                    <TextBlock Text="Введите символы с картинки" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TbCaptcha" ToolTip="Введите символы с картинки"
                             ContextMenu="{x:Null}" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="ButtonEnter" Content="Войти" ToolTip="Кнопка входа" Click="ButtonEnter_Click"
                        IsDefault="True" />
                <Button x:Name="ButtonReg" Content="Регистрация" ToolTip="Кнопка регистрации"
                        Style="{StaticResource SecondaryButton}" Click="ButtonReg_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
