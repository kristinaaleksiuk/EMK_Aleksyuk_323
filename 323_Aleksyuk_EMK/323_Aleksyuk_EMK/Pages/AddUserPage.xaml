<Page x:Class="_323_Aleksyuk_EMK.Pages.AddUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_323_Aleksyuk_EMK.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
         Title="ЭМК — Пользователь">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="430" Margin="0,16">
            <TextBlock x:Name="TbTitle" Text="Новый пользователь" Style="{StaticResource TitleText}" />

            <TextBlock Text="ФИО" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="TbFio" ToolTip="Введите ФИО" />

            <TextBlock Text="Логин" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="TbLogin" ToolTip="Введите логин" />

            <TextBlock x:Name="LblPass" Text="Пароль" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="PbPass" ToolTip="Введите пароль" />

            <TextBlock Text="Роль" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="CbRole" ToolTip="Выберите роль">
                <ComboBoxItem Content="User" />
                <ComboBoxItem Content="Admin" />
            </ComboBox>

            <TextBlock Text="Фото (необязательно)" Style="{StaticResource FieldLabel}" />
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="TbPhoto" ToolTip="Путь к файлу фотографии" />
                <Button Content="Выбрать фото" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Click="BtnBrowse_Click" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Сохранить" ToolTip="Сохранить данные" Click="BtnSave_Click" />
                <Button Content="Отмена" ToolTip="Вернуться к списку" Style="{StaticResource SecondaryButton}" Click="BtnCancel_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>