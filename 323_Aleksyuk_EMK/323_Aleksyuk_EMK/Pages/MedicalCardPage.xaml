<Page x:Class="_323_Aleksyuk_EMK.Pages.MedicalCardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_323_Aleksyuk_EMK.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
         Title="ЭМК — Медицинская карта" Loaded="Page_Loaded">
    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Медицинская карта" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
            <TextBlock x:Name="TbPatient" FontSize="14" TextWrapping="Wrap" />
        </StackPanel>

        <TextBox Grid.Row="1" x:Name="TbCard" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" Padding="10" Style="{StaticResource ReadOnlyBox}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Назад" Style="{StaticResource SecondaryButton}" ToolTip="Вернуться на главную страницу" Click="BtnBack_Click" />
        </StackPanel>
    </Grid>
</Page>