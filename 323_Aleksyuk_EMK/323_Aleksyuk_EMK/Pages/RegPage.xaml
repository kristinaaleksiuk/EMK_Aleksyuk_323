<Page x:Class="_323_Aleksyuk_EMK.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_323_Aleksyuk_EMK"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
        Title="ЭМК — Регистрация">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,16">
            <TextBlock Text="Регистрация пациента" Style="{StaticResource TitleText}" />
            <Grid Width="550">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Width="260" HorizontalAlignment="Left">
                    <TextBlock Text="ФИО" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TbFio" ToolTip="Введите фамилию, имя и отчество" />
                    <Label x:Name="lblFioHint" Content="Введите ФИО" Style="{StaticResource HintLabel}"
MouseLeftButtonUp="lblFioHint_MouseLeftButtonUp"/>
                    <TextBlock Text="Пароль (от 6 символов, цифра)" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="PbFirst" ToolTip="Введите пароль" />
                    <Label x:Name="lblPassHint" Content="Введите пароль" Style="{StaticResource HintLabel}"
MouseLeftButtonUp="lblPassHint_MouseLeftButtonUp"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Width="260" HorizontalAlignment="Right">
                    <TextBlock Text="Логин" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TbLogin" ToolTip="Введите логин"/>
                    <Label x:Name="lblLoginHint" Content="Введите логин" Style="{StaticResource HintLabel}"
           MouseLeftButtonUp="lblLoginHint_MouseLeftButtonUp"/>
                    
                    <TextBlock Text="Повтор пароля" Style="{StaticResource FieldLabel}" />
                    
                    <PasswordBox x:Name="PbSecond" ToolTip="Повторите пароль" />
                    <Label x:Name="lblPassSecHint" Content="Повторите пароль" Style="{StaticResource HintLabel}"
           MouseLeftButtonUp="lblPassSecHint_MouseLeftButtonUp" />
                </StackPanel>
            </Grid>

            <Grid Width="550" Margin="0,6,0,0">
                
                <Grid.ColumnDefinitions>
                    
                    <ColumnDefinition Width="*" />
                    
                    <ColumnDefinition Width="*" />
                    
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Width="260" HorizontalAlignment="Left">
                  
                    <TextBlock Text="Пол" Style="{StaticResource FieldLabel}" />
                   
                    <ComboBox x:Name="CbGender" SelectedIndex="0" ToolTip="Выберите пол">
                       
                        <ComboBoxItem Content="М" />
                       
                        <ComboBoxItem Content="Ж" />
                       
                    </ComboBox>
                    

                    <TextBlock Text="Номер полиса ОМС (16 цифр)" Style="{StaticResource FieldLabel}" />
                    
                    <TextBox x:Name="TbPolicy" MaxLength="16" ToolTip="Номер полиса ОМС: 16 цифр"
                            PreviewTextInput="TbPolicy_PreviewTextInput" />
                        

                        <TextBlock Text="Электронная почта" Style="{StaticResource FieldLabel}" />
                      
                        <TextBox x:Name="TbEmail" MaxLength="100" ToolTip="Например: name@mail.ru" />
                    
                </StackPanel>
            
                <StackPanel Grid.Column="1" Width="260" HorizontalAlignment="Right">
                   
                    <TextBlock Text="Дата рождения" Style="{StaticResource FieldLabel}" />
                    
                    <DatePicker x:Name="DpBirth" ToolTip="Выберите дату рождения"
                               SelectedDateChanged="DpBirth_SelectedDateChanged" />
                        

                        <TextBlock Text="Телефон" Style="{StaticResource FieldLabel}" />
                        
                        <TextBox x:Name="TbPhone" MaxLength="20" ToolTip="Например: +7 900 123-45-67"
                             PreviewTextInput="TbPhone_PreviewTextInput" />
                           

                            <StackPanel x:Name="GuardianPanel" Visibility="Collapsed">
                                
                                <TextBlock Text="ФИО законного представителя" Style="{StaticResource FieldLabel}" />
                               
                                <TextBox x:Name="TbGuardian" MaxLength="150"
                                ToolTip="Для пациентов младше 18 лет: родитель или опекун" />
                                  
                            </StackPanel>
                            
                </StackPanel>
                
            </Grid>
            

            <CheckBox x:Name="ChkConsent" Width="550" Margin="0,12,0,0"
                      Content="Даю согласие на обработку персональных данных (Федеральный закон № 152-ФЗ)" />


                <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}"
                       Text="Пароль должен содержать не менее 6 символов и цифру" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BtnRegister" Content="Зарегистрироваться" ToolTip="Создать учётную запись"
                        Click="BtnRegister_Click" />
                <Button x:Name="BtnCancel" Content="Отмена" ToolTip="Вернуться к авторизации"
                        Style="{StaticResource SecondaryButton}" Click="BtnCancel_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>