<Page x:Class="_323_Aleksyuk_EMK.Pages.DoctorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_323_Aleksyuk_EMK.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
           Title="ЭМК — Страница врача" Loaded="Page_Loaded">
    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Фото, ФИО, специализация и кабинет -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Grid Width="96" Height="96">
                <Ellipse Fill="{DynamicResource SecondaryBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" />
                <Ellipse x:Name="PhotoEllipse" Margin="2" />
                <TextBlock x:Name="PhotoHint" Text="Фото" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#7A7F8C" FontSize="12" />
            </Grid>
            <StackPanel VerticalAlignment="Center" Margin="22,0,0,0">
                <TextBlock x:Name="TbName" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" />
                <TextBlock x:Name="TbInfo" FontSize="14" Margin="0,4,0,0" />
                <TextBlock x:Name="TbDoctorInfo" FontSize="14" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Заголовок и фильтры -->
        <StackPanel Grid.Row="1" Margin="0,10,0,8">
            <TextBlock Text="Приёмы пациентов" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Статус" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                    <ComboBox x:Name="CbStatus" SelectedIndex="0" Width="200" ToolTip="Фильтр по статусу"
                              SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="Все" />
                        <ComboBoxItem Content="Запланирован" />
                        <ComboBoxItem Content="Завершён" />
                        <ComboBoxItem Content="Отменён" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Период" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                    <ComboBox x:Name="CbPeriod" SelectedIndex="0" Width="200" ToolTip="Фильтр по дате"
                              SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="Все даты" />
                        <ComboBoxItem Content="Сегодня" />
                        <ComboBoxItem Content="Предстоящие" />
                    </ComboBox>
                </StackPanel>
                <Button Content="Сбросить" VerticalAlignment="Bottom" Style="{StaticResource SecondaryButton}"
                        ToolTip="Очистить фильтры" Click="BtnReset_Click" />
            </StackPanel>
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="DgAppointments" ToolTip="Приёмы пациентов">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding schedule.visit_date, StringFormat=dd.MM.yyyy}" Width="*" />
                <DataGridTextColumn Header="Время" Binding="{Binding schedule.time_start, StringFormat=hh\\:mm}" Width="0.7*" />
                <DataGridTextColumn Header="Пациент" Binding="{Binding patient.fio}" Width="2*" />
                <DataGridTextColumn Header="Телефон" Binding="{Binding patient.phone}" Width="1.3*" />
                <DataGridTextColumn Header="Статус" Binding="{Binding status}" Width="1.2*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Провести приём" ToolTip="Анализы, диагноз, лечение и отчёт по выбранному приёму" Click="BtnVisit_Click" />
            <Button Content="Отменить приём" ToolTip="Отменить выбранный приём (время снова станет свободным)"
                    Style="{StaticResource DangerButton}" Click="BtnCancel_Click" />
            <Button Content="Сменить пароль" ToolTip="Сменить пароль" Style="{StaticResource SecondaryButton}" Click="BtnChangePass_Click" />
            <Button Content="Выйти" ToolTip="Выйти из системы" Style="{StaticResource SecondaryButton}" Click="BtnLogout_Click" />
        </StackPanel>
    </Grid>
</Page>