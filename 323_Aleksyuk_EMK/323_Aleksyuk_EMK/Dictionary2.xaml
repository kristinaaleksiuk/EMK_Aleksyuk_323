<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        ВТОРАЯ (собственная) ТЕМА - зелёная гамма. Шаг 3, п. 4-5 методички.
        Те же ключи, другие цвета: 2 основных + 2 дополнительных.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="PageBackground"      Color="#F6FBF8" />
    <SolidColorBrush x:Key="PanelBackground"     Color="#DCEFE5" />
    <SolidColorBrush x:Key="AccentBrush"         Color="#E3A008" />
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#1E6B52" />
    <SolidColorBrush x:Key="DangerBrush"         Color="#C0392B" />
    <SolidColorBrush x:Key="SecondaryBrush"      Color="#D5E3DB" />

    <SolidColorBrush x:Key="OnPrimaryBrush"      Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryTextBrush"  Color="#1E6B52" />
    <SolidColorBrush x:Key="TextBrush"           Color="#1B2A24" />
    <SolidColorBrush x:Key="InputBackground"     Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush"    Color="#7FA796" />
    <SolidColorBrush x:Key="RowAltBrush"         Color="#EAF4EE" />
    <SolidColorBrush x:Key="GridLineBrush"       Color="#D5E3DB" />
    <SolidColorBrush x:Key="SelectionBrush"      Color="#FBE9B7" />
    <SolidColorBrush x:Key="CaptchaTextBrush"    Color="#1E6B52" />
</ResourceDictionary>
