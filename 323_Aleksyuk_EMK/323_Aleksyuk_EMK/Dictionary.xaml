<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        ОСНОВНАЯ ТЕМА - строго по Руководству по стилю (макет):
        2 основных цвета + светлые нейтральные, 2 дополнительных.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Основные -->
    <SolidColorBrush x:Key="PageBackground"      Color="#FFFFFF" />
    <!-- Основной белый: фон страниц -->
    <SolidColorBrush x:Key="PanelBackground"     Color="#F3F3F3" />
    <!-- Светло-серый: верхняя и нижняя панели -->
    <SolidColorBrush x:Key="AccentBrush"         Color="#0198AF" />
    <!-- Бирюзовый: акцентная линия -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#233E76" />
    <!-- Тёмно-синий: кнопки, шапки таблиц, заголовки -->
    <!-- Дополнительные -->
    <SolidColorBrush x:Key="DangerBrush"         Color="#DD4842" />
    <!-- Красный: удаление, ошибки -->
    <SolidColorBrush x:Key="SecondaryBrush"      Color="#EAEBED" />
    <!-- Серый: вторичные кнопки, фон капчи -->

    <!-- Производные -->
    <SolidColorBrush x:Key="OnPrimaryBrush"      Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryTextBrush"  Color="#233E76" />
    <SolidColorBrush x:Key="TextBrush"           Color="#1F2430" />
    <SolidColorBrush x:Key="InputBackground"     Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush"    Color="#9AA0B4" />
    <SolidColorBrush x:Key="RowAltBrush"         Color="#F3F3F3" />
    <SolidColorBrush x:Key="GridLineBrush"       Color="#EAEBED" />
    <SolidColorBrush x:Key="SelectionBrush"      Color="#CDEBF0" />
    <SolidColorBrush x:Key="CaptchaTextBrush"    Color="#1F6F7A" />
</ResourceDictionary>
