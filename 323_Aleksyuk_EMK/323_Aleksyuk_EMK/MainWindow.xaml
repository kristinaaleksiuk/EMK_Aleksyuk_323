<Window x:Class="_323_Aleksyuk_EMK.MainWindow"
        xmlns:charts="clrnamespace:System.Windows.Forms.DataVisualization.Charting;assembly=System.Windows.Forms.DataVisualization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_323_Aleksyuk_EMK"
        mc:Ignorable="d"
        Title="Приём и ведение ЭМК"
        Width="1000" Height="640" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource AppFont}"
        Foreground="{DynamicResource TextBrush}"
        Background="{DynamicResource PageBackground}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <!-- Шаг 2: Grid из трёх строк: 45 / * / 45 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="33*"/>
            <ColumnDefinition Width="217*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="45" />
            <RowDefinition Height="*" />
            <RowDefinition Height="45" />
        </Grid.RowDefinitions>

        
        <Border Grid.Row="0" Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,3" Grid.ColumnSpan="2">
            <Grid>
                <Button x:Name="BackButton" Content="Назад" HorizontalAlignment="Left"
                        Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                        ToolTip="Вернуться на предыдущую страницу" Click="BackButton_Click"
                        Visibility="Hidden" />
                <TextBlock x:Name="TitleText" Text="ЭМК" HorizontalAlignment="Center"
                           VerticalAlignment="Center" FontWeight="Bold" FontSize="14"
                           Foreground="{DynamicResource PrimaryBrush}" />
                <Button x:Name="ThemeButton" Content="Сменить тему" HorizontalAlignment="Right"
                        Margin="0,0,8,0" Style="{StaticResource SecondaryButton}"
                        ToolTip="Сменить тему" Click="ThemeButton_Click" />
            </Grid>
        </Border>

        <!-- Шаг 2, п. 3-4: Frame для страниц, навигационная строка скрыта -->
        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"
               Background="{DynamicResource PageBackground}" Grid.ColumnSpan="2" />

        <!-- Нижняя панель: название приложения слева, дата и время справа -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBackground}" Grid.ColumnSpan="2" Margin="0,534,0,0" Grid.RowSpan="2">
            <Grid Margin="16,0">
                <TextBlock Text="Приём и ведение ЭМК" VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryBrush}" />
                <TextBlock x:Name="DateTimeNow" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
