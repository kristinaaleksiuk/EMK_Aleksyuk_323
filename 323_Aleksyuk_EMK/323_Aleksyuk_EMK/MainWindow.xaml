<Window x:Class="_323_Aleksyuk_EMK.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_323_Aleksyuk_EMK"
        mc:Ignorable="d"
        Title="Приём и ведение ЭМК" 
        Height="600" Width="900"
        MinHeight="500" MinWidth="800"
        Loaded="Window_Loaded" Closing="Window_Closing">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <Button x:Name="BtnBack" Content="Назад" HorizontalAlignment="Left"
                ToolTip="Вернуться на предыдущую страницу"
                Click="BtnBack_Click" Width="81"/>

        <Frame x:Name="MainFrame" Grid.Row="1"
               NavigationUIVisibility="Hidden"
               Navigated="MainFrame_Navigated"/>

        <TextBlock x:Name="DateTimeNow" Grid.Row="2"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   Margin="0,0,15,0" ToolTip="Текущая дата и время"/>

    </Grid>
</Window>
