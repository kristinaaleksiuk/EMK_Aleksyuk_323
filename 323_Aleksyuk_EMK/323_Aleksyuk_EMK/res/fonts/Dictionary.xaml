<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Тема 1: по Руководству по стилю (светлая) -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBrush"    Color="#F3F3F3"/>
    <SolidColorBrush x:Key="TextBrush"       Color="#193D57"/>
    <SolidColorBrush x:Key="AccentBrush"     Color="#0198AF"/>
    <SolidColorBrush x:Key="ButtonBrush"     Color="#233E76"/>
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrushMain" Color="#9197A3"/>
    <SolidColorBrush x:Key="ErrorBrush"      Color="#DD4842"/>
</ResourceDictionary>
