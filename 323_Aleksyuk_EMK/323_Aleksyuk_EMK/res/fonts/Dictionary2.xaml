<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Тема 2: собственная (тёмная), на дополнительных цветах руководства -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#193D57"/>
    <SolidColorBrush x:Key="SurfaceBrush"    Color="#256569"/>
    <SolidColorBrush x:Key="TextBrush"       Color="#EAEBED"/>
    <SolidColorBrush x:Key="AccentBrush"     Color="#4DC6C5"/>
    <SolidColorBrush x:Key="ButtonBrush"     Color="#006B80"/>
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrushMain" Color="#9197A3"/>
    <SolidColorBrush x:Key="ErrorBrush"      Color="#FF8A84"/>
</ResourceDictionary>
